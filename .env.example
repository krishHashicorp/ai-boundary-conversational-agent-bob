# WatsonX.ai credentials
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
#WATSONX_MODEL_ID=ibm/granite-3-1-8b-instruct
WATSONX_MODEL_ID=your_watsonx_model_id_here

# HCP Boundary — user authentication
BOUNDARY_ADDR=https://your_boundary_cluster_id.boundary.hashicorp.cloud
BOUNDARY_AUTH_METHOD=oidc
BOUNDARY_AUTH_METHOD_ID=your_boundary_auth_method_id_here
BOUNDARY_LOGIN_NAME=your_boundary_login_name_here
# BOUNDARY_PASSWORD is no longer set here — the agent prompts for it at startup (masked input).
# You may still set it here for non-interactive / CI use:
# BOUNDARY_PASSWORD=your-password

# HCP Boundary — OIDC (used when BOUNDARY_AUTH_METHOD=oidc)
BOUNDARY_OIDC_AUTH_METHOD_ID=your_boundary_oidc_auth_method_id_here

# HCP Boundary — target
# SSH target IDs start with tssh_
BOUNDARY_TARGET_ID=your_boundary_target_id_here

# SSH — username on the Ubuntu target
# No SSH password needed: Boundary credential injection handles it
SSH_USERNAME=your_ssh_username_here

# Inactivity timeout — disconnect from Boundary + host after this many seconds of no user input
# Default: 3600 (1 hour). Examples: 1800 = 30 min, 300 = 5 min
INACTIVITY_TIMEOUT_SECONDS=3600
